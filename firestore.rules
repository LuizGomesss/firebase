rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsTenantData() {
      return signedIn() && request.auth.uid == resource.data.clientId;
    }

    function writesOwnTenantData() {
      return signedIn() && request.auth.uid == request.resource.data.clientId;
    }

    match /clients/{clientId} {
      allow read, update, delete: if signedIn() && request.auth.uid == clientId;
      allow create: if signedIn() && request.auth.uid == clientId;
    }

    match /connections/{connectionId} {
      allow read, update, delete: if ownsTenantData();
      allow create: if writesOwnTenantData();
    }

    match /contacts/{contactId} {
      allow read, update, delete: if ownsTenantData();
      allow create: if writesOwnTenantData();
    }

    match /messages/{messageId} {
      allow read, update, delete: if ownsTenantData();
      allow create: if writesOwnTenantData();
    }
  }
}
